{
  "name": "q9chat",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/Q9Labs/q9stack/tree/main/templates/base#readme",
  "bugs": "https://github.com/Q9Labs/q9stack/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/q9stack",
    "directory": "templates/base"
  },
  "type": "module",
  "scripts": {
    "dev": "q9 dev start -- pnpm run dev:run",
    "dev:run": "pnpm run dev:server",
    "dev:prepare": "turbo run dev:prepare --filter=@q9chat/web",
    "dev:server": "turbo run @q9chat/web#dev:server @q9chat/convex#dev:convex --concurrency=20",
    "dev:status": "q9 dev status",
    "dev:logs": "q9 dev logs",
    "dev:stop": "q9 dev stop",
    "diag": "q9 diag",
    "web:dev": "pnpm --filter @q9chat/web run dev",
    "build": "pnpm run convex:codegen && turbo run build",
    "typecheck": "pnpm run convex:codegen && pnpm run typecheck:convex && turbo run typecheck && pnpm run typecheck:fixtures",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:fixtures": "tsc --noEmit -p seeds/tsconfig.json",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm run convex:codegen && pnpm run test:convex && turbo run test && pnpm run test:fixtures",
    "test:convex": "vitest run convex",
    "test:fixtures": "vitest run seeds",
    "gate": "pnpm run test:fixtures && pnpm tracker:check && pnpm changelog:check && q9gate run",
    "gate:full": "pnpm run test:fixtures && pnpm tracker:check && pnpm changelog:check && q9gate run --full",
    "tracker:check": "q9 tracker check",
    "changelog:check": "q9 changelog check",
    "changelog:export": "q9 changelog export --out apps/web/src/generated/changelog.json",
    "deploy:web": "pnpm --filter @q9chat/web run deploy",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "seed": "tsx seeds/run.ts",
    "i18n:extract": "pnpm --filter @q9chat/web exec lingui extract"
  },
  "dependencies": {
    "@convex-dev/better-auth": "catalog:",
    "@faker-js/faker": "catalog:",
    "@q9labsai/diagnostics": "^0.4.0",
    "better-auth": "catalog:",
    "convex": "catalog:"
  },
  "devDependencies": {
    "@lingui/cli": "catalog:",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@lingui/vite-plugin": "catalog:",
    "@q9labsai/cli": "catalog:",
    "@q9labsai/config-depcruise": "catalog:",
    "@q9labsai/config-oxlint": "catalog:",
    "@q9labsai/config-semgrep": "catalog:",
    "@q9labsai/config-tsconfig": "catalog:",
    "@q9labsai/gates": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "convex-test": "catalog:",
    "cspell": "catalog:",
    "dependency-cruiser": "catalog:",
    "fallow": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react-doctor": "catalog:",
    "syncpack": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.3"
}
