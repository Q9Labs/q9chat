{
  "name": "q9chat",
  "version": "0.1.0",
  "private": true,
  "description": "Q9 Chat: a calm, fast, reliable team chat.",
  "homepage": "https://github.com/Q9Labs/q9chat#readme",
  "bugs": "https://github.com/Q9Labs/q9chat/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/q9chat"
  },
  "type": "module",
  "scripts": {
    "dev": "q9 dev start -- pnpm run dev:run",
    "dev:run": "pnpm run dev:server",
    "dev:prepare": "turbo run dev:prepare --filter=@q9chat/web",
    "dev:server": "turbo run @q9chat/web#dev:server @q9chat/convex#dev:convex --concurrency=20",
    "dev:status": "q9 dev status",
    "dev:logs": "q9 dev logs",
    "dev:stop": "q9 dev stop",
    "web:dev": "pnpm --filter @q9chat/web run dev",
    "build": "turbo run build",
    "typecheck": "pnpm run typecheck:convex && turbo run typecheck",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "gate": "pnpm tracker:check && pnpm changelog:check && q9gate run",
    "gate:full": "pnpm tracker:check && pnpm changelog:check && q9gate run --full",
    "tracker:check": "q9 tracker check",
    "changelog:check": "q9 changelog check",
    "deploy:web": "pnpm --filter @q9chat/web run deploy",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "test:backend": "vitest run --config convex/vitest.config.ts"
  },
  "dependencies": {
    "@q9chat/domain": "workspace:*",
    "convex": "catalog:",
    "effect": "3.22.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@q9labsai/cli": "catalog:",
    "@q9labsai/config-depcruise": "catalog:",
    "@q9labsai/config-oxlint": "catalog:",
    "@q9labsai/config-semgrep": "catalog:",
    "@q9labsai/config-tsconfig": "catalog:",
    "@q9labsai/gates": "catalog:",
    "@types/node": "catalog:",
    "@types/web-push": "3.6.4",
    "convex-test": "0.0.62",
    "cspell": "catalog:",
    "dependency-cruiser": "catalog:",
    "fallow": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react-doctor": "catalog:",
    "syncpack": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.3"
}
