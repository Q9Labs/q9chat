# Public values the phone bundle reads at build time. None of them is a secret.
# The dev Convex deployment (cloud URL, and its HTTP-action origin for uploads and photos).
EXPO_PUBLIC_CONVEX_URL=https://quixotic-crab-23.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://quixotic-crab-23.convex.site
# The web Worker that serves /api/auth/* and /auth/phone-callback.
# The staging WorkOS environment registers only http://localhost:3000/auth/phone-callback for the phone.
EXPO_PUBLIC_AUTH_ORIGIN=http://localhost:3000
# The WorkOS client id of that environment; the same value as VITE_WORKOS_CLIENT_ID in the root .env.local.
EXPO_PUBLIC_WORKOS_CLIENT_ID=
