{
  "expo": {
    "name": "Q9 Chat",
    "slug": "q9chat",
    "scheme": "q9chat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.q9labs.chat",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.q9labs.chat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#111118"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#111118"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Q9 Chat uses your photos so you can choose a profile picture."
        }
      ],
      "expo-audio",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "ca32262b-b798-4a89-bd97-bd051e71d5c4"
      }
    },
    "owner": "q9labs"
  }
}
