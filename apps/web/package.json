{
  "name": "@q9chat/web",
  "version": "0.1.0",
  "description": "The Q9 Chat web app",
  "homepage": "https://github.com/Q9Labs/q9chat/tree/main/apps/web#readme",
  "bugs": "https://github.com/Q9Labs/q9chat/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/q9chat",
    "directory": "apps/web"
  },
  "files": [
    ".output",
    "src",
    "e2e",
    "README.md",
    "playwright.config.ts",
    "wrangler.jsonc"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/router.tsx",
      "import": "./src/router.tsx"
    },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm -w exec turbo run @q9chat/web#dev:server --concurrency=20",
    "dev:server": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@q9labsai/ui": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@workos-inc/authkit-react": "catalog:",
    "convex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "catalog:",
    "@q9labsai/config-tsconfig": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
