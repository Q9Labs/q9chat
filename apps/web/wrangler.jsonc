{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "q9chat-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "chat.q9labs.ai",
      "custom_domain": true,
    },
  ],
  "ratelimits": [
    { "name": "AUTH_START_IP", "namespace_id": "9001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_START_EMAIL", "namespace_id": "9002", "simple": { "limit": 3, "period": 60 } },
    { "name": "AUTH_VERIFY_IP", "namespace_id": "9003", "simple": { "limit": 60, "period": 60 } },
    {
      "name": "AUTH_VERIFY_EMAIL",
      "namespace_id": "9004",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
}
