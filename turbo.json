{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "concurrency": "50%",
  "globalEnv": ["NODE_ENV", "CI", "VITE_CONVEX_URL", "VITE_WORKOS_CLIENT_ID", "CONVEX_DEPLOYMENT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.*", "!**/*.spec.*"],
      "outputs": ["dist/**", ".output/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/dist/**", "!**/coverage/**"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "dev:prepare": {
      "dependsOn": ["^dev:prepare"],
      "cache": false,
      "outputs": ["dist/**"]
    },
    "dev:watch": {
      "dependsOn": ["dev:prepare"],
      "cache": false,
      "persistent": true
    },
    "dev:server": {
      "dependsOn": ["^dev:prepare"],
      "cache": false,
      "persistent": true
    },
    "@q9chat/web#dev:server": {
      "dependsOn": ["^dev:prepare"],
      "with": ["@q9chat/convex#dev:watch"],
      "cache": false,
      "persistent": true
    },
    "dev:convex": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    }
  }
}
