{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "concurrency": "50%",
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "APP_ENV",
    "APP_URL",
    "LOG_LEVEL",
    "OPENROUTER_API_KEY",
    "SENTRY_DSN",
    "VITE_CONVEX_URL",
    "CONVEX_DEPLOYMENT",
    "BETTER_AUTH_SECRET",
    "SITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.*", "!**/*.spec.*"],
      "outputs": ["dist/**", ".output/**", "build/**"]
    },
    "codegen": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "@q9chat/convex#typecheck": {
      "dependsOn": ["codegen"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/dist/**", "!**/coverage/**"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "dev:prepare": {
      "dependsOn": ["^dev:prepare"],
      "cache": false,
      "outputs": ["dist/**"]
    },
    "dev:watch": {
      "dependsOn": ["dev:prepare"],
      "cache": false,
      "persistent": true
    },
    "dev:server": {
      "dependsOn": ["^dev:prepare"],
      "cache": false,
      "persistent": true
    },
    "@q9chat/web#dev:server": {
      "dependsOn": ["^dev:prepare"],
      "with": ["@q9chat/auth#dev:watch", "@q9chat/convex#dev:watch", "@q9chat/env#dev:watch"],
      "cache": false,
      "persistent": true
    },
    "dev:convex": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    }
  }
}
