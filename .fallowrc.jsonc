{
  // Project-wide fallow config; `q9gate` runs `fallow audit` through the fallow lane.
  "entry": [
    "gate.config.ts",
    "e2e.config.ts",
    "e2e.phone.config.ts",
    "e2e.android.config.ts",
    "tests/*.e2e.ts",
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.wrangler/**",
    "**/.output/**",
    "**/routeTree.gen.ts",
    "convex/_generated/**",
  ],
  // Same ceilings as q9stack itself: split functions instead of raising these.
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 15,
    "maxCrap": 60,
  },
  // Consumed by q9gate lane commands and config extends rather than imports.
  // Expo loads expo-dev-client and expo-system-ui through app.json plugins and native autolinking, and
  // expo-font through @expo-google-fonts, so no source file imports them.
  "ignoreDependencies": [
    "@q9labsai/config-oxlint",
    "@q9labsai/config-semgrep",
    "react-doctor",
    "expo-dev-client",
    "expo-font",
    "expo-system-ui",
  ],
  // The phone ports web's auth contracts and journey steps because the apps share no UI or client package.
  "duplicates": {
    // The same journey runs on web, iOS and Android, so its end-to-end steps repeat on purpose.
    "ignore": ["tests/*.e2e.ts"],
    "ignoredClones": [
      "dup:c77b3abb6f87acd9-r1:2",
      "dup:c77b3abb6f87acd9-r2:2",
      "dup:c77b3abb6f87acd9-r3:2",
      "dup:39277f89:2",
    ],
  },
  "audit": {
    "gate": "all",
  },
}
