# Runtime environment: dev or prod.
APP_ENV=
# Public application origin, for example https://app.example.com.
APP_URL=
# Log level used by server-side services.
LOG_LEVEL=
# Server-only OpenRouter credential. Never commit its value.
OPENROUTER_API_KEY=
# Optional Sentry project DSN.
SENTRY_DSN=
# Public Convex URL used by the web client.
VITE_CONVEX_URL=
# Better Auth signing and encryption secret.
BETTER_AUTH_SECRET=
# Trusted public site origin used by Better Auth.
SITE_URL=
