# Public Convex URL used by the web client.
VITE_CONVEX_URL=
# HTTP actions; required for local Convex (normally http://127.0.0.1:3211).
# Cloud deployments can derive this from VITE_CONVEX_URL.
VITE_CONVEX_SITE_URL=
# Server-only WORKOS_API_KEY and WORKOS_CLIENT_ID belong in apps/web/.dev.vars.

# Public Web Push key matching the Convex deployment VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=
