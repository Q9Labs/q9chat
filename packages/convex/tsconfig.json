{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@q9labsai/config-tsconfig/tsconfig.library.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": [
    "src",
    "*.config.ts",
    "../../seeds/accounts.ts",
    "../../seeds/faker.ts",
    "../../seeds/sample.ts",
    "../core/src/**/*.ts",
    "../../convex/_generated/**/*.ts"
  ],
  "exclude": ["dist"]
}
