# Runtime mode: dev or prod.
APP_ENV=
# Public application origin.
APP_URL=
# Runtime log level.
LOG_LEVEL=
# Server-only OpenRouter credential. Keep this value empty in the template.
OPENROUTER_API_KEY=
# Optional public Sentry project DSN.
SENTRY_DSN=
# Public Convex URL used by the web client.
VITE_CONVEX_URL=
# Server-only Better Auth signing and encryption secret.
BETTER_AUTH_SECRET=
# Trusted public site origin used by Better Auth.
SITE_URL=
